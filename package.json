{
  "name": "scam-reports",
  "version": "0.2.10",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "homepage": "https://scam-reports.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scamreportsorg/scam-reports.org.git"
  },
  "bugs": {
    "url": "https://github.com/scamreportsorg/scam-reports.org/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --persist-to .wrangler/state",
    "preview": "npm run build && npm start",
    "setup:local": "node scripts/setup-local-env.mjs",
    "setup:local:check": "node scripts/setup-local-env.mjs --check",
    "test": "npm run build && npm run test:node",
    "test:node": "node --test --test-concurrency=1 tests/*.test.mjs",
    "build:e2e": "cross-env NEXT_PUBLIC_TURNSTILE_SITE_KEY=ci-validation-only-site-key vinext build",
    "test:e2e": "npm run build:e2e && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:ui": "npm run build:e2e && playwright test --ui",
    "test:security": "node --test --test-concurrency=1 tests/auth-security.test.mjs tests/evidence-v2.test.mjs",
    "build:staging": "cross-env CLOUDFLARE_ENV=staging vinext build",
    "build:production": "cross-env CLOUDFLARE_ENV=production vinext build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply scam-reports-local --local",
    "db:seed:staging-performance": "node scripts/seed-staging-performance.mjs",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:identity": "node scripts/check-release-tags.mjs",
    "release:check": "node scripts/release-check.mjs",
    "audit:publication": "node scripts/audit-publication.mjs",
    "audit:github-metadata": "node scripts/audit-github-metadata.mjs",
    "operator:d1-export": "node scripts/operator-d1-export.mjs",
    "operator:r2-backup-download": "node scripts/operator-r2-backup-download.mjs",
    "operator:restore-test": "node scripts/operator-restore-dry-run.mjs",
    "operator:evidence-inventory": "node scripts/operator-evidence-inventory.mjs",
    "operator:legacy-evidence-quarantine": "node scripts/operator-legacy-evidence-quarantine.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.51.1",
    "@cloudflare/workers-types": "5.20260810.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1",
    "wrangler": "4.120.0"
  },
  "type": "module"
}
