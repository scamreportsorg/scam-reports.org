# Public origins and source transparency. AUTH_APP_ORIGIN is exact and also
# selects secure __Host- cookies for HTTPS versus local cookies for HTTP.
APP_ENVIRONMENT=development
AUTH_RUNTIME_ENV=development
AUTH_APP_ORIGIN=http://localhost:3000
PUBLIC_RELEASE_VERSION=0.2.10-dev
PUBLIC_SOURCE_COMMIT=development
PUBLIC_SOURCE_URL=https://github.com/scamreportsorg/scam-reports.org
PUBLIC_SOURCE_AVAILABLE=false
PUBLIC_BUILD_TIME=unreleased
PUBLIC_SCHEMA_VERSION=22

# Required cryptographic secrets (generate independent random values; never reuse)
IDENTITY_HASH_KEY=replace-with-at-least-32-random-bytes
IDENTITY_ENCRYPTION_KEY=replace-with-32-byte-base64-key
INTAKE_PEPPER=replace-with-at-least-32-random-bytes

# Discord OAuth application
DISCORD_CLIENT_ID=replace-with-discord-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret

# Email magic links (Resend)
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=Scam-Reports.org <login@auth.scam-reports.org>
MODERATOR_NOTIFICATION_EMAIL=replace-with-private-moderator-email

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Protected build-only deployment identifiers (select the matching environment)
STAGING_D1_DATABASE_ID=replace-with-staging-d1-database-id
PRODUCTION_D1_DATABASE_ID=replace-with-production-d1-database-id

# One-time first-admin bootstrap. Follow docs/AUTHENTICATION.md and remove both
# values from Cloudflare after successful bootstrap.
BOOTSTRAP_DISCORD_ID=replace-with-discord-user-id
BOOTSTRAP_ADMIN_EMAIL=replace-with-admin-email

# Discord community ranks and operational channels. Keep disabled until the
# roles, hierarchy, webhooks, migrations, and deployment pass the checklist in
# docs/DISCORD_INTEGRATION.md.
DISCORD_ROLE_SYNC_ENABLED=false
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_GUILD_ID=replace-with-discord-guild-id
DISCORD_ROLE_LEVEL_1_ID=replace-with-lv1-newcomer-role-id
DISCORD_ROLE_LEVEL_2_ID=replace-with-lv2-contributor-role-id
DISCORD_ROLE_LEVEL_3_ID=replace-with-lv3-regular-role-id
DISCORD_ROLE_LEVEL_4_ID=replace-with-lv4-senior-contributor-role-id
DISCORD_ROLE_LEVEL_5_ID=replace-with-lv5-veteran-role-id
DISCORD_ROLE_LEVEL_6_ID=replace-with-lv6-community-guardian-role-id
DISCORD_COMMUNITY_INVITE_URL=https://discord.gg/replace-with-invite-code
DISCORD_STATUS_WEBHOOK_URL=replace-with-public-status-webhook-url
MODERATOR_DISCORD_WEBHOOK_URL=replace-with-private-moderation-webhook-url

# Private attack monitor. The channel ID is configuration; both API tokens are secrets.
SECURITY_MONITOR_ENABLED=false
DISCORD_SECURITY_CHANNEL_ID=replace-with-private-security-channel-id
CLOUDFLARE_ZONE_ID=replace-with-cloudflare-zone-id
CLOUDFLARE_SECURITY_API_TOKEN=replace-with-read-only-analytics-token

# Backup workflow: restricted API token with D1 Read/Export scope only
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-environment-d1-database-id
CLOUDFLARE_BACKUP_API_TOKEN=replace-with-restricted-d1-export-token

# Staging gate; required by the staging Worker before any application route is served.
STAGING_ACCESS_TOKEN=replace-with-random-staging-token
